{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aof.local/schemas/aof.schema.json",
  "title": "AOF Config",
  "type": "object",
  "required": ["name", "resources"],
  "properties": {
    "name": { "type": "string" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    },
    "globalRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/globalRef" }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "namespace", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "source": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/packageSource" }
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                    "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
                  },
                  "additionalProperties": true
                }
              ]
            }
          },
          "resources": {
            "type": "array",
            "items": { "$ref": "#/$defs/resource" }
          },
          "runtimes": {
            "type": "array",
            "items": { "enum": ["claude", "codex"] }
          }
        },
        "additionalProperties": true
      }
    },
    "mcpServers": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcpServer" }
    },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hook" }
    },
    "projectDocs": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectDoc" }
    },
    "settings": { "$ref": "#/$defs/settings" },
    "work": { "$ref": "#/$defs/work" },
    "memory": { "$ref": "#/$defs/memory" },
    "items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runtimes": {
      "type": "array",
      "items": { "enum": ["claude", "codex"] }
    }
  },
  "$defs": {
    "globalRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["skill", "agent", "rule", "workflow"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
      },
      "additionalProperties": true
    },
    "argument": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "body": { "type": "string" },
        "path": { "type": "string" },
        "argumentHint": { "type": "string" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["skill", "command", "agent", "rule"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "body": { "type": "string" },
        "prompt": { "type": "string" },
        "instructions": { "type": "string" },
        "path": { "type": "string" },
        "model": { "type": "string" },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workflow": { "type": "string" },
        "argumentHint": { "type": "string" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        },
        "argumentOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "hint": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "overrides": {
          "type": "object",
          "properties": {
            "claude": { "$ref": "#/$defs/runtimeOverride" },
            "codex": { "$ref": "#/$defs/runtimeOverride" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "packageSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "npm" },
            "package": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "tag": { "type": "string" },
            "range": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "git" },
            "url": { "type": "string" },
            "ref": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "file" },
            "path": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "runtimeOverride": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "body": { "type": "string" },
            "prompt": { "type": "string" },
            "instructions": { "type": "string" },
            "model": { "type": "string" },
            "tools": {
              "type": "array",
              "items": { "type": "string" }
            },
            "paths": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "mcpServer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "transport": { "enum": ["stdio", "http", "sse"] },
        "command": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "url": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "hook": {
      "type": "object",
      "required": ["id", "event"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "event": { "enum": ["PreToolUse", "PostToolUse", "Notification", "Stop", "SubagentStop", "UserPromptSubmit", "SessionStart", "SessionEnd", "PreCompact"] },
        "matcher": { "type": "string" },
        "type": { "enum": ["command"] },
        "command": { "type": "string" },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "projectDoc": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "path": { "type": "string" },
        "body": { "type": "string" },
        "targets": {
          "type": "array",
          "items": { "enum": ["AGENTS.md", "CLAUDE.md"] }
        },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "trust": { "enum": ["read-only", "workspace", "full"] },
        "autoCompact": { "type": "boolean" },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "work": {
      "type": "object",
      "description": "Configuration for the ACD (Acceptance-Criteria Development) work stream: the flat, chronological stream of milestone / story / task / uat items.",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Path, relative to the repo root, to the flat work-item stream (NN_type_slug folders)."
        },
        "agents": {
          "type": "object",
          "description": "How ACD role agents are orchestrated.",
          "properties": {
            "mode": {
              "enum": ["orchestrated", "solo"],
              "description": "orchestrated = the main session spawns role sub-agents; solo = the main session performs every role inline."
            },
            "productOwner": {
              "enum": ["inline", "agent"],
              "description": "inline = the main session authors SPEC/story/acceptance; agent = delegate authoring to the aof-product-owner sub-agent."
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "object",
          "description": "Project-specific tag vocabulary (the closed set the validator enforces). Universal tags (@executable, @manual, @bug, @wip, @milestone-NN, @uat-<id>) are owned by the framework, not configured here.",
          "properties": {
            "layers": { "type": "array", "items": { "type": "string" } },
            "refinements": { "type": "array", "items": { "type": "string" } },
            "domains": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "description": "UI / design-review settings. ACD does NOT boot the app — the project runs it; ACD only points at it.",
          "properties": {
            "baseUrl": { "type": "string", "description": "Base URL of the running app the design-conformance review renders surfaces against (e.g. https://localhost:1234); each DESIGN.md surface's Route is appended. Overridable per run with `aof:verify --url`." }
          },
          "additionalProperties": false
        },
        "headroom": {
          "type": "object",
          "description": "OPTIONAL headroom plugin config (milestone 06). Absent ≡ off — the work-board terminal launch is byte-for-byte unchanged when this block is absent or { enabled: false }. Closed (additionalProperties:false), peer to work.ui.",
          "properties": {
            "enabled": { "type": "boolean", "description": "The master switch. An absent block OR enabled:false leaves the terminal launch unchanged (raw passthrough)." },
            "mode": { "enum": ["wrap"], "description": "wrap ONLY in v0; proxy is rejected at the schema (ADR-002 — a different runtime topology, not yet shipped). An enabled block with no mode defaults to wrap at runtime." },
            "providers": { "type": "array", "items": { "enum": ["claude", "codex"] }, "description": "OPTIONAL subset of routable providers to front; absent ⇒ both [\"claude\",\"codex\"]. gemini is never a valid member (ADR-003 — not OpenAI-compatible, never routable)." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "description": "Work-memory backend selection (milestone 05). OPTIONAL — an absent `memory` key is equivalent to { \"backend\": \"none\" } (the graceful no-op). `backend` is an enum of the registered backend names.",
      "properties": {
        "backend": {
          "enum": ["local", "none"],
          "description": "The memory backend that answers the `aof work memory` verbs. `local` = the cheap derived-index backend; `none` = a no-op so ACD runs unchanged when memory is absent."
        }
      },
      "additionalProperties": false
    }
  }
}
