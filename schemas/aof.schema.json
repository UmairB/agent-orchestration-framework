{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aof.local/schemas/aof.schema.json",
  "title": "AOF Config",
  "type": "object",
  "required": ["name", "resources"],
  "properties": {
    "name": { "type": "string" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    },
    "globalRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/globalRef" }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "namespace", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "source": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/packageSource" }
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
                    "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
                  },
                  "additionalProperties": true
                }
              ]
            }
          },
          "resources": {
            "type": "array",
            "items": { "$ref": "#/$defs/resource" }
          },
          "runtimes": {
            "type": "array",
            "items": { "enum": ["claude", "codex"] }
          }
        },
        "additionalProperties": true
      }
    },
    "mcpServers": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcpServer" }
    },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hook" }
    },
    "projectDocs": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectDoc" }
    },
    "settings": { "$ref": "#/$defs/settings" },
    "items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runtimes": {
      "type": "array",
      "items": { "enum": ["claude", "codex"] }
    }
  },
  "$defs": {
    "globalRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["skill", "agent", "rule"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["skill", "command", "agent", "rule"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "body": { "type": "string" },
        "prompt": { "type": "string" },
        "instructions": { "type": "string" },
        "path": { "type": "string" },
        "model": { "type": "string" },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "overrides": {
          "type": "object",
          "properties": {
            "claude": { "$ref": "#/$defs/runtimeOverride" },
            "codex": { "$ref": "#/$defs/runtimeOverride" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "packageSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "npm" },
            "package": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "tag": { "type": "string" },
            "range": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "git" },
            "url": { "type": "string" },
            "ref": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "file" },
            "path": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "runtimeOverride": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "body": { "type": "string" },
            "prompt": { "type": "string" },
            "instructions": { "type": "string" },
            "model": { "type": "string" },
            "tools": {
              "type": "array",
              "items": { "type": "string" }
            },
            "paths": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "mcpServer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "transport": { "enum": ["stdio", "http", "sse"] },
        "command": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "url": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "hook": {
      "type": "object",
      "required": ["id", "event"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "event": { "enum": ["PreToolUse", "PostToolUse", "Notification", "Stop", "SubagentStop", "UserPromptSubmit", "SessionStart", "SessionEnd", "PreCompact"] },
        "matcher": { "type": "string" },
        "type": { "enum": ["command"] },
        "command": { "type": "string" },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "projectDoc": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "path": { "type": "string" },
        "body": { "type": "string" },
        "targets": {
          "type": "array",
          "items": { "enum": ["AGENTS.md", "CLAUDE.md"] }
        },
        "runtimes": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "trust": { "enum": ["read-only", "workspace", "full"] },
        "autoCompact": { "type": "boolean" },
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
