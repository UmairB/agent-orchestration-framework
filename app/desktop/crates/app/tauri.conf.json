{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aof mesh",
  "version": "0.1.0",
  "identifier": "com.aof.mesh.desktop",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "aof mesh",
        "url": "index.html",
        "width": 760,
        "height": 520,
        "decorations": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
